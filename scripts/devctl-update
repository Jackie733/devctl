#!/usr/bin/env bash
set -euo pipefail
umask 077

fail() {
    printf 'devctl-update: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: devctl-update FILE_OR_HTTPS_URL SHA256\n       devctl-update --rollback\n'
}

if [[ ${1:-} == --help && $# == 1 ]]; then
    usage
    exit 0
fi
if [[ ${1:-} == --rollback && $# == 1 ]]; then
    rollback=true
elif [[ $# == 2 && $2 =~ ^[[:xdigit:]]{64}$ ]]; then
    rollback=false
else
    usage >&2
    exit 1
fi

[[ $(uname -s) == Linux ]] || fail 'This installer supports Linux / WSL2 only.'
for tool in flock mktemp cp mv chmod timeout sha256sum cmp; do
    command -v "$tool" >/dev/null || fail "Required command is missing: $tool"
done

bin_dir="$HOME/.local/bin"
target="$bin_dir/devctl"
previous="$bin_dir/devctl.previous"
mkdir -p -- "$bin_dir"
exec 9>"$bin_dir/.devctl-update.lock"
flock -n 9 || fail 'Another update is in progress.'
for path in "$target" "$previous"; do
    [[ ! -L "$path" ]] || fail "Refusing to replace a symbolic link: $path"
    [[ ! -e "$path" || -f "$path" ]] || fail "Not a regular file: $path"
done

# Staging beside the destination keeps the final rename on one filesystem.
stage=$(mktemp -d "$bin_dir/.devctl-update.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT

if "$rollback"; then
    [[ -f "$previous" ]] || fail 'No previous version is available.'
    cp -- "$previous" "$stage/devctl"
else
    case "$1" in
        https://*)
            command -v curl >/dev/null || fail 'Required command is missing: curl'
            curl --disable --fail --location --silent --show-error \
                --proto '=https' --proto-redir '=https' \
                --connect-timeout 10 --max-time 180 --retry 2 \
                --output "$stage/devctl" -- "$1"
            ;;
        *://*) fail 'Only local files and HTTPS URLs are supported.' ;;
        *) cp -- "$1" "$stage/devctl" ;;
    esac
    actual=$(sha256sum -- "$stage/devctl")
    actual=${actual%% *}
    [[ "$actual" == "${2,,}" ]] || fail 'SHA-256 mismatch; installed version unchanged.'
fi

chmod 755 -- "$stage/devctl"
version=$(timeout 5 "$stage/devctl" --version) || fail 'Candidate cannot run; installed version unchanged.'
[[ "$version" == 'devctl '* ]] || fail 'Candidate did not report a devctl version.'

# A repeated install should not discard the useful rollback copy.
if [[ -f "$target" ]] && cmp -s -- "$target" "$stage/devctl"; then
    printf 'Already installed: %s\n' "$version"
    exit 0
fi
if [[ -f "$target" ]]; then
    cp -- "$target" "$stage/previous"
    mv -fT -- "$stage/previous" "$previous"
fi
mv -fT -- "$stage/devctl" "$target"
printf 'Installed: %s\nPath: %s\n' "$version" "$target"
printf 'Existing background processes are unchanged. Start a new workspace after shutdown.\n'
