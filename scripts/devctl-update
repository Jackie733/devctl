#!/usr/bin/env bash
set -euo pipefail
umask 077

fail() {
    printf 'devctl-update: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: devctl-update FILE_OR_HTTPS_URL SHA256\n       devctl-update --rollback\n'
}

if [[ ${1:-} == --help && $# == 1 ]]; then
    usage
    exit 0
fi
if [[ ${1:-} == --rollback && $# == 1 ]]; then
    rollback=true
elif [[ $# == 2 && $2 =~ ^[[:xdigit:]]{64}$ ]]; then
    rollback=false
else
    usage >&2
    exit 1
fi

case $(uname -s) in
    Linux) required_tools='flock mktemp cp mv chmod timeout sha256sum cmp tr' ;;
    Darwin) required_tools='perl shasum mktemp cp mv chmod cmp tr' ;;
    *) fail 'This installer supports Linux / WSL2 and macOS only.' ;;
esac
for tool in $required_tools; do
    command -v "$tool" >/dev/null || fail "Required command is missing: $tool"
done

replace_file() {
    if [[ $(uname -s) == Darwin ]]; then
        # rename replaces a file/link atomically and rejects a directory, like
        # GNU mv -T. BSD mv would move the candidate inside a raced-in directory.
        perl -e 'rename($ARGV[0], $ARGV[1]) or die "devctl-update: Cannot replace file: $!\n"' "$1" "$2"
    else
        mv -fT -- "$1" "$2"
    fi
}

install_locked() {
    local bin_dir="$HOME/.local/bin"
    local target="$bin_dir/devctl"
    local previous="$bin_dir/devctl.previous"
    local rollback=false
    [[ ${1:-} != --rollback ]] || rollback=true
    for path in "$target" "$previous"; do
        [[ ! -L "$path" ]] || fail "Refusing to replace a symbolic link: $path"
        [[ ! -e "$path" || -f "$path" ]] || fail "Not a regular file: $path"
    done

    # Staging beside the destination keeps the final rename on one filesystem.
    stage=$(mktemp -d "$bin_dir/.devctl-update.XXXXXXXX")
    trap 'rm -rf -- "$stage"' EXIT

    if "$rollback"; then
        [[ -f "$previous" ]] || fail 'No previous version is available.'
        cp -- "$previous" "$stage/devctl"
    else
        case "$1" in
            https://*)
                command -v curl >/dev/null || fail 'Required command is missing: curl'
                curl --disable --fail --location --silent --show-error \
                    --proto '=https' --proto-redir '=https' \
                    --connect-timeout 10 --max-time 180 --retry 2 \
                    --output "$stage/devctl" -- "$1"
                ;;
            *://*) fail 'Only local files and HTTPS URLs are supported.' ;;
            *) cp -- "$1" "$stage/devctl" ;;
        esac
        if [[ $(uname -s) == Darwin ]]; then
            actual=$(shasum -a 256 -- "$stage/devctl")
        else
            actual=$(sha256sum -- "$stage/devctl")
        fi
        actual=${actual%% *}
        expected=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
        [[ "$actual" == "$expected" ]] || fail 'SHA-256 mismatch; installed version unchanged.'
    fi

    chmod 755 "$stage/devctl"
    if [[ $(uname -s) == Darwin ]]; then
        version=$(perl -e 'alarm 5; exec @ARGV or die "Cannot execute candidate: $!\n"' "$stage/devctl" --version) || fail 'Candidate cannot run; installed version unchanged.'
    else
        version=$(timeout 5 "$stage/devctl" --version) || fail 'Candidate cannot run; installed version unchanged.'
    fi
    [[ "$version" == 'devctl '* ]] || fail 'Candidate did not report a devctl version.'
    if [[ -n ${DEVCTL_UPDATE_EXPECTED_VERSION:-} ]]; then
        [[ "$version" == "devctl $DEVCTL_UPDATE_EXPECTED_VERSION" ]] || fail 'Candidate version does not match release; installed version unchanged.'
    fi

    # A repeated install should not discard the useful rollback copy.
    if [[ -f "$target" ]] && cmp -s -- "$target" "$stage/devctl"; then
        printf 'Already installed: %s\n' "$version"
        exit 0
    fi
    if [[ -f "$target" ]]; then
        cp -- "$target" "$stage/previous"
        replace_file "$stage/previous" "$previous"
    fi
    replace_file "$stage/devctl" "$target"
    printf 'Installed: %s\nPath: %s\n' "$version" "$target"
    printf 'Existing background processes are unchanged. Start a new workspace after shutdown.\n'
}

mkdir -p -- "$HOME/.local/bin"
exec 9>"$HOME/.local/bin/.devctl-update.lock"
if [[ $(uname -s) == Darwin ]]; then
    # macOS ships Perl but no flock command. Lock the same open file description
    # as fd 9, which survives exec and remains held throughout the Bash installer.
    export -f fail replace_file install_locked
    perl -MFcntl=:flock -e '
        flock(STDIN, LOCK_EX | LOCK_NB) or die "devctl-update: Another update is in progress.\n";
        exec @ARGV or die "devctl-update: Cannot run installer: $!\n";
    ' bash -euo pipefail -c 'exec </dev/null; install_locked "$@"' devctl-update "$@" <&9
else
    flock -n 9 || fail 'Another update is in progress.'
    install_locked "$@"
fi
